<mujoco model="fly_ohtani">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <geom condim="3" friction="0.8 0.02 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <joint damping="0.02" armature="0.001"/>
  </default>

  <asset>
    <material name="ground_mat" rgba="0.12 0.14 0.16 1"/>
    <material name="agent_mat" rgba="0.1 0.35 0.75 1"/>
    <material name="limb_mat" rgba="0.95 0.75 0.15 1"/>
    <material name="ball_mat" rgba="0.95 0.18 0.18 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="-2 -3 4" dir="1 1 -2" diffuse="0.9 0.9 0.9"/>
    <camera name="tracking" pos="1.3 -3.4 1.5" xyaxes="1 0 0 0 0.34 0.94"/>
    <geom name="ground" type="plane" size="4 2 0.1" material="ground_mat"/>

    <body name="agent_body" pos="0 0 0.36">
      <geom name="thorax" type="ellipsoid" size="0.08 0.045 0.06" mass="0.0009" material="agent_mat"/>
      <body name="swing_limb" pos="0.02 0 0.03">
        <joint name="swing_hinge" type="hinge" axis="0 1 0" range="-1.4 1.4" limited="true"/>
        <geom
          name="swing_limb_geom"
          type="capsule"
          fromto="0 0 0 0.58 0 0"
          size="0.018"
          mass="0.003"
          material="limb_mat"
        />
      </body>
    </body>

    <body name="ball" pos="-2.2 0 0.55">
      <!-- damping=0 overrides the <default> joint damping (meant for the actuated
           swing_hinge): a free-flying ball should not have artificial viscous
           drag on its translational/rotational DOFs, or launch-velocity
           corrections for gravity cannot land on target. -->
      <joint name="ball_free" type="free" damping="0"/>
      <geom name="ball_geom" type="sphere" size="0.045" mass="0.145" material="ball_mat"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="swing_motor" joint="swing_hinge" gear="0.01" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
